{
  "name": "weeknotes-dashboard",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.3",
    "liquidjs": "^10.29.0",
    "lowdb": "^7.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
